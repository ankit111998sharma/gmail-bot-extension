# Copy this file to .env and adjust if needed. Never commit real OAuth files.

# Gmail OAuth (Desktop app JSON downloaded from Google Cloud)
GMAIL_CREDENTIALS_PATH=data/gmail/credentials.json
GMAIL_TOKEN_PATH=data/gmail/token.json

# Inbox poll
GMAIL_QUERY=is:unread label:INBOX
GMAIL_POLL_SECONDS=60
GMAIL_LABEL=GmailBot-Drafted

# Draft generation: placeholder | ollama
INBOX_LLM=placeholder
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3

# Optional extra filter (leave blank to process all matches of GMAIL_QUERY)
GMAIL_SENDER_FILTER=
GMAIL_KEYWORD_FILTER=

# SQLite + logs live under the project folder so the app is portable
DATABASE_PATH=data/gmail_bot.db
LOG_PATH=logs/assistant.log
KNOWLEDGE_DIR=data/knowledge
